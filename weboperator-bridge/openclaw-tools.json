{
  "name": "openclaw-weboperator",
  "version": "1.6.0",
  "description": "OpenClaw agent toolset configuration for WebOperator",
  "gateway": {
    "url": "http://127.0.0.1:8765/mcp",
    "headers": {
      "x-weboperator-token": "${WEBOPERATOR_API_TOKEN:-}"
    }
  },
  "tools": [
    "browser_snapshot",
    "browser_navigate",
    "browser_click",
    "browser_type",
    "browser_press",
    "browser_scroll",
    "browser_screenshot",
    "browser_extract",
    "browser_solve_captcha",
    "weboperator_execute_goal",
    "browser_eval",
    "browser_wait",
    "tabs_list",
    "tabs_current",
    "tabs_open",
    "tabs_activate",
    "tabs_close",
    "agent_task_start",
    "agent_task_list",
    "agent_task_get",
    "agent_task_stop",
    "agent_task_confirm",
    "agent_task_pause",
    "agent_task_resume",
    "agent_task_wait",
    "browser_image",
    "browser_select_option",
    "browser_handle_dialog",
    "network_list",
    "network_get",
    "network_clear",
    "console_list",
    "cookies_get",
    "cookies_set",
    "storage_get",
    "storage_set",
    "browser_upload_file",
    "browser_download",
    "downloads_list",
    "downloads_read",
    "browser_read",
    "browser_hover",
    "browser_drag",
    "clipboard_read",
    "clipboard_write"
  ]
}
