{
  "name": "weboperator",
  "version": "1.2.0",
  "private": true,
  "description": "Chrome Browser Agent",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc --noEmit && vite build",
    "build:eval": "tsc --noEmit && vite build --mode development",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:extension": "node ../scripts/eval-extension.mjs",
    "eval:repeat": "node ../scripts/eval-repeat.mjs"
  },
  "dependencies": {
    "dexie": "^4.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@types/chrome": "^0.0.270",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "playwright": "^1.59.1",
    "typescript": "^5.5.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "rollup": "4.60.3"
  }
}
