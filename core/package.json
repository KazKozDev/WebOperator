{
  "name": "weboperator",
  "version": "1.4.0",
  "private": true,
  "description": "AI browser agent and MCP server for Chrome automation",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc --noEmit && vite build",
    "build:eval": "tsc --noEmit && vite build --mode development",
    "typecheck": "tsc --noEmit",
    "lint": "cd .. && core/node_modules/.bin/eslint --config core/eslint.config.js core/src core/manifest.config.ts core/vite.config.ts scripts/*.mjs weboperator-bridge/*.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "deadcode": "knip --config knip.json --include files,dependencies,unlisted,unresolved,binaries --no-config-hints",
    "shellcheck": "shellcheck ../scripts/check.sh ../weboperator-bridge/install.sh ../weboperator-bridge/native-host.sh",
    "check": "npm run typecheck && npm run lint && npm test && npm run deadcode && npm run shellcheck && npm run build",
    "eval:extension": "node ../scripts/eval-extension.mjs",
    "eval:repeat": "node ../scripts/eval-repeat.mjs",
    "eval:assistantbench": "node ../scripts/fetch-assistantbench.mjs && node ../scripts/eval-extension.mjs --tasks evals/assistantbench.json"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "dexie": "^4.0.8",
    "pdfmake": "^0.3.11",
    "react": "^18.3.1",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.0.270",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "knip": "^6.14.1",
    "playwright": "^1.59.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "rollup": "4.60.3"
  }
}
